// Included at the end of the native gameplay fragment entry point. The builder
// maps the DKB_* names to the captured module and retains its original alpha.
//
// With Brightness Source = Game and the default sliders, this computes the
// revised correction verified offline (build/renodx-gameplay/corrected.spv,
// ef4eed6a): peakRatio is the game's own ratio, sceneScale is exactly 1 and
// values outside the calibrated domain pass through unchanged.

// Vanilla with the recompilation's highlight shoulder (shared.h).
if (shader_injection.tone_map_type == DKB_TONE_MAP_TYPE_SHOULDER) {
  DKB_OUTPUT.rgb = DkbRecompShoulder(DKB_OUTPUT.rgb, DKB_NATIVE_BRIGHTNESS, DKB_C3[1], DKB_C3[4]);
  return;
}
// Vanilla, or no settings pushed (zeroed push range): stock output.
if (!DkbIsExtended()) return;

float nativePeakRatio = DKB_C3[4].x;
float gameWhite = DKB_C3[5].x;
float knee = DKB_C3[4].y;
float slope = DKB_C3[1].z;
float center = DKB_C3[1].w;
float3 power = DKB_C3[3].rgb * DKB_C3[3].w;
if (!(gameWhite > 0.f)) return;

// RenoDX brightness. The final encoder maps 1.0 to the game's white, and the
// game draws its HUD at that level after this pass, so only the scene scales.
float diffuseNits = gameWhite;
float peakNits = gameWhite * nativePeakRatio;
float peakRatio = nativePeakRatio;  // exact game value, as in the tested build
float sceneScale = 1.f;
if (shader_injection.brightness_source == DKB_BRIGHTNESS_SOURCE_CUSTOM) {
  diffuseNits = shader_injection.diffuse_white_nits;
  peakNits = shader_injection.peak_white_nits;
  if (!(diffuseNits > 0.f && peakNits > 0.f)) return;
  peakNits = max(peakNits, diffuseNits);
  peakRatio = peakNits / diffuseNits;
  sceneScale = diffuseNits / gameWhite;
}

// Composite values are relative to diffuse white (1.0 = diffuse white).
float3 nativeRGB = DKB_OUTPUT.rgb;
float3 outRGB = nativeRGB;
float nativeMaxChannel = max(nativeRGB.x, max(nativeRGB.y, nativeRGB.z));
do {
  // Calibrated domain. Unequal channel powers (a tinted grade) are mapped
  // through the curve's input (shared.h DkbSceneFromExposed).
  if (!(nativePeakRatio > 1.f && peakRatio > 1.f && knee > 0.18f && knee < 1.f
        && nativeMaxChannel > knee && slope > 0.f && DkbPowerDomain(power)
        && DKB_C3[0].z > 0.f)) break;

  // Invert the scalar vanilla response at middle gray. The exposed scene
  // input supplies the highlight values.
  float sigmaBlack = 1.f / (1.f + exp(center * slope));
  float sigmaWhite = 1.f / (1.f + exp((center - 1.f) * slope));
  float sigmaGray = lerp(sigmaBlack, sigmaWhite, -log(1.f - 0.18f));
  if (!(sigmaGray > 0.f && sigmaGray < 1.f)) break;
  float nativeGray = center + log(sigmaGray / (1.f - sigmaGray)) / slope;
  if (!(nativeGray > 0.f)) break;
  renodx::draw::Config config = renodx::draw::BuildConfig();
  config.diffuse_white_nits = diffuseNits;
  config.graphics_white_nits = gameWhite;
  config.peak_white_nits = peakNits;
  float grayInput = DkbGrayInput(peakRatio, config.reno_drt_white_clip);
  float3 scene = DkbSceneFromExposed(DKB_EXPOSED_RGB, power, nativeGray, grayInput);

  // Remove the native LUT texel-center offset for the neutral reference. The
  // two references share the game's independent brightness and highlight
  // chroma.
  float3 identityLut = saturate((DKB_LUT_UVW - DKB_C3[0].w) / DKB_C3[0].z);
  float3 gameLuma = float3(0.29891199f, 0.58661097f, 0.114478f);
  float identityY = dot(identityLut, gameLuma);
  float gradeY = dot(DKB_GRADED_RGB, gameLuma);
  if (!(identityY > 1e-10f && gradeY > 1e-10f)) break;
  float3 neutralSDR = DKB_NATIVE_BRIGHTNESS * max(0.f, lerp(1.f, identityLut / identityY, DKB_CHROMA));
  float3 gradedSDR = DKB_NATIVE_BRIGHTNESS * max(0.f, lerp(1.f, DKB_GRADED_RGB / gradeY, DKB_CHROMA));

  // The measured final encoder takes linear Display P3 D65. RenoDX draw takes
  // linear BT.709 coordinates, including signed channels.
  float3 scene709 = mul(renodx::color::DISPLAYP3_TO_BT709_MAT, scene);
  float3 graded709 = mul(renodx::color::DISPLAYP3_TO_BT709_MAT, gradedSDR);
  float3 neutral709 = mul(renodx::color::DISPLAYP3_TO_BT709_MAT, neutralSDR);
  float3 hdr709 = DkbToneMap(scene709, graded709, neutral709, config, peakRatio,
    DkbGrayContrast(nativeGray, sigmaGray, sigmaBlack, sigmaWhite, slope, power));
  if (!all(isfinite(hdr709))) break;
  float3 hdrP3 = mul(renodx::color::BT709_TO_DISPLAYP3_MAT, hdr709);
  float outputY = renodx::color::y::from::BT709(hdr709);
  if (!(outputY > 0.f)) break;
  hdrP3 = max(0.f, renodx::color::correct::GamutCompress(hdrP3, outputY));
  // Saturated P3 primaries can reach the max-channel knee at low luminance.
  // Preserve the native luminance when the gray-anchored DRT curve is lower.
  float nativeY = dot(nativeRGB, renodx::color::DISPLAYP3_TO_XYZ_MAT[1]);
  hdrP3 = renodx::color::correct::Luminance(hdrP3, outputY, max(outputY, nativeY));
  float maxP3 = max(hdrP3.x, max(hdrP3.y, hdrP3.z));
  hdrP3 *= peakRatio / max(maxP3, peakRatio);
  // Preserve the native knee and blend into RenoDRT by diffuse white. HUD and
  // display encoding run downstream in their original passes.
  outRGB = lerp(nativeRGB, hdrP3, smoothstep(knee, 1.f, nativeMaxChannel));
} while (false);

// A custom peak below the game's own ratio also limits native values. In Game
// mode the game has already clamped native values to its ratio.
if (shader_injection.brightness_source == DKB_BRIGHTNESS_SOURCE_CUSTOM) {
  float outMax = max(outRGB.x, max(outRGB.y, outRGB.z));
  outRGB *= peakRatio / max(outMax, peakRatio);
}
DKB_OUTPUT.rgb = outRGB * sceneScale;
